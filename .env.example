# URL pública final, incluindo eventual subpasta e com barra no fim.
# Exemplos: https://portfolio.example.com/ ou https://usuario.github.io/repositorio/
VITE_SITE_URL=https://portfolio.example.com/

# A access key do Web3Forms é pública e será incluída no bundle do navegador.
VITE_WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key
